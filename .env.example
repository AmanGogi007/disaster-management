# Copy to .env

# === Elevation / DEM ===
# Options: sample | srtm | copernicus
ELEVATION_PROVIDER=sample
DEM_DATA_PATH=./data/raw/dem
# For SRTM/NASA via opentopography or similar
OPENTOPOGRAPHY_API_KEY=
# Google Elevation API (optional, paid)
GOOGLE_MAPS_API_KEY=

# === Hydrology ===
# Options: osm | local
HYDROLOGY_PROVIDER=osm
OVERPASS_URL=https://overpass-api.de/api/interpreter
HYDROLOGY_DATA_PATH=./data/raw/hydrology

# === Historical floods ===
HISTORICAL_FLOOD_PROVIDER=stub
HISTORICAL_FLOOD_DATA_PATH=./data/raw/floods

# === Cache ===
CACHE_DIR=./data/cache

# === Scoring weights ===
FLOOD_DISTANCE_WEIGHT=0.25
FLOOD_ELEVATION_WEIGHT=0.25
FLOOD_CONNECTIVITY_WEIGHT=0.20
FLOOD_HISTORICAL_WEIGHT=0.15
FLOOD_FLOW_ACCUMULATION_WEIGHT=0.15